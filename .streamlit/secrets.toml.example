DATABASE_URL = "postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require"
MATCHWELL_ADMIN_EMAILS = "owner@example.com"
# Production must NOT auto-migrate on every app boot: run migrations as a
# separate, privileged operator/CI step (`uv run alembic upgrade head`)
# using a privileged database role, then keep the application's own runtime
# role restricted to DML only (SELECT/INSERT/UPDATE/DELETE -- no CREATE,
# ALTER, or DROP). See docs/security/pilot-launch-checklist.md.
MATCHWELL_AUTO_MIGRATE = false
MATCHWELL_ENVIRONMENT = "production"

# Stripe test-mode billing. Leave every STRIPE_ value unset to keep billing
# disabled; the member Billing page then shows a clear configuration error
# instead of failing silently. The companion FastAPI webhook service reads
# these same names from its own process environment, not from this file.
STRIPE_SECRET_KEY = "sk_test_YOUR_TEST_SECRET_KEY"
STRIPE_WEBHOOK_SECRET = "whsec_YOUR_TEST_WEBHOOK_SECRET"
STRIPE_PILOT_PRICE_ID = "price_YOUR_TEST_PILOT_PRICE_ID"
MATCHWELL_CHECKOUT_SUCCESS_URL = "https://YOUR-APP.streamlit.app/billing?checkout=success"
MATCHWELL_CHECKOUT_CANCEL_URL = "https://YOUR-APP.streamlit.app/billing?checkout=cancel"
MATCHWELL_BILLING_PORTAL_RETURN_URL = "https://YOUR-APP.streamlit.app/billing"
MATCHWELL_BILLING_GRACE_DAYS = 7

[auth]
redirect_uri = "https://YOUR-APP.streamlit.app/oauth2callback"
# Generate with a CSPRNG, at least 32 bytes (256 bits), base64- or hex-
# encoded, e.g.:
#   PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
#   Prefer a real CSPRNG instead: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Rotate periodically (e.g. quarterly) and immediately after any suspected
# leak. Rotating invalidates every existing signed-in session cookie, so
# rotate during a low-traffic window and expect every member to sign back
# in. Never reuse a development secret in production.
cookie_secret = "GENERATE_A_CSPRNG_SECRET_AT_LEAST_32_BYTES"
client_id = "YOUR_GOOGLE_CLIENT_ID"
client_secret = "YOUR_GOOGLE_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"